# ─── Firebase Auth (client) ───────────────────────────────────────────────────
# Firebase Console → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Convex ───────────────────────────────────────────────────────────────────
# Written to .env.local for you by `npx convex dev`. On Vercel these are not
# set by hand: `npx convex deploy` (vercel.json) injects NEXT_PUBLIC_CONVEX_URL
# using the CONVEX_DEPLOY_KEY you add in Vercel → Settings → Environment Variables.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Set these on each Convex deployment (dev / preview / prod), NOT here:
#   npx convex env set FIREBASE_PROJECT_ID your_project_id    (required — verifies sign-ins)
#   npx convex env set ADVISOR_HOURLY_LIMIT 30                (optional — AI requests per user per hour)

# ─── AI Advisor (server only — never prefix with NEXT_PUBLIC_) ───────────────
# Any OpenAI-compatible Chat Completions API. Defaults to NVIDIA NIM
# (key from https://build.nvidia.com). See docs/LLM.md.
LLM_API_KEY=your_llm_api_key
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=qwen/qwen3.5-122b-a10b
# LLM_MAX_TOKENS=2048
